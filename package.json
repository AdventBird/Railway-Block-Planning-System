{
  "name": "railway-block-planning-system",
  "version": "1.0.0",
  "private": true,
  "description": "Intelligent Railway Block Planning, Evaluation, and Optimization System",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "python -m backend.app.api",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:frontend": "npm run build --prefix frontend",
    "test:backend": "python -m pytest backend/app/tests"
  },
  "keywords": [
    "railway",
    "block-planning",
    "scheduling",
    "optimization",
    "react",
    "vite",
    "python"
  ]
}
